# Renamed build for the Lenovo Y700 Gen4 (tb322fc-linux): every split package
# carries -y700-gen4 and stands in for the repo package at the same version via
# exact-version provides + conflicts/replaces, so repo updates cannot clobber
# the patched build (turnip sparse/VM-bind, a830 chip-ids, ir3 bindless UBO).
# pkgbase stays "mesa" so makepkg --noextract reuses the configured build dir.
pkgbase=mesa
pkgname=(
  mesa-y700-gen4
  opencl-mesa-y700-gen4
  vulkan-asahi-y700-gen4
  vulkan-broadcom-y700-gen4
  vulkan-dzn-y700-gen4
  vulkan-freedreno-y700-gen4
  vulkan-gfxstream-y700-gen4
  vulkan-intel-y700-gen4
  vulkan-nouveau-y700-gen4
  vulkan-panfrost-y700-gen4
  vulkan-powervr-y700-gen4
  vulkan-radeon-y700-gen4
  vulkan-swrast-y700-gen4
  vulkan-virtio-y700-gen4
  vulkan-mesa-implicit-layers-y700-gen4
  vulkan-mesa-layers-y700-gen4
  mesa-docs-y700-gen4
)
pkgver=26.2.4
_pkgver=${pkgver/[a-z]/-&}
pkgrel=1
epoch=1
pkgdesc="Open-source OpenGL drivers"
url="https://www.mesa3d.org/"
arch=(aarch64 x86_64)
license=("MIT AND BSD-3-Clause AND SGI-B-2.0")
makedepends=(
  clang
  git
