  python-yaml
  rust-bindgen
  wayland-protocols
  xorgproto

  # mesa-only deps
  valgrind

  # html-docs
)
options=(
  # GCC 14 LTO causes segfault in LLVM under si_llvm_optimize_module
  # https://gitlab.freedesktop.org/mesa/mesa/-/issues/11140
  #
  # In general, upstream considers LTO to be broken until explicit notice.
  !lto
)
_freedom_commit=9788014a0293dc26745b000d02854ad88ef73e88
source=(
  "https://archive.mesa3d.org/mesa-$_pkgver.tar.xz"{,.sig}
  "armadaos-freedom::git+https://github.com/mydanyi/armadaos-freedom.git#commit=$_freedom_commit"
)
