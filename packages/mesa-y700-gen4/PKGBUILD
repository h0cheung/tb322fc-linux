    systemd-libs
    vulkan-icd-loader
    vulkan-mesa-implicit-layers-y700-gen4
    wayland
    xcb-util-keysyms
    zlib
    zstd
  )
  optdepends=("vulkan-mesa-layers-y700-gen4: additional vulkan layers")
  provides=(vulkan-driver)

  # tb322fc: renamed build; stand in for the repo package at the same version
  provides+=("vulkan-nouveau=$epoch:$pkgver-$pkgrel")
  conflicts+=(vulkan-nouveau)
  replaces+=(vulkan-nouveau)

  mv vknvidia/* "$pkgdir"

  # Allow one atomic transaction from the matching development split.
  conflicts+=("${pkgname}-git")

  install -Dm644 mesa-$_pkgver/docs/license.rst -t "$pkgdir/usr/share/licenses/$pkgname"
}

