--- a/usr/share/gamescope-session-plus/sessions.d/steam
+++ b/usr/share/gamescope-session-plus/sessions.d/steam
@@ -30,6 +30,25 @@
 export STEAM_USE_MANGOAPP=1
 
 export STEAM_USE_DYNAMIC_VRS=1
+
+_armada_swipe_gestures_config="${ARMADA_SWIPE_GESTURES_CONFIG:-/etc/armada/swipe-gestures.conf}"
+# In-game gestures remain subordinate to the master setting.
+export GAMESCOPE_TOUCH_GESTURES_IN_GAME=1
+if [[ -r "$_armada_swipe_gestures_config" ]]; then
+    while IFS= read -r _armada_line || [[ -n "$_armada_line" ]]; do
+        if [[ "$_armada_line" =~ ^[[:space:]]*enabled[[:space:]]*=[[:space:]]*([01])[[:space:]]*$ ]]; then
+            # Any nonempty value, including 0, disables gestures in the launcher.
+            if [[ "${BASH_REMATCH[1]}" == 0 ]]; then
+                export DISABLE_TOUCH_GESTURES=1
+            else
+                export DISABLE_TOUCH_GESTURES=
+            fi
+        elif [[ "$_armada_line" =~ ^[[:space:]]*in_game[[:space:]]*=[[:space:]]*([01])[[:space:]]*$ ]]; then
+            export GAMESCOPE_TOUCH_GESTURES_IN_GAME="${BASH_REMATCH[1]}"
+        fi
+    done <"$_armada_swipe_gestures_config"
+fi
+unset _armada_swipe_gestures_config _armada_line
 
 # Set up first time bootstrap status
 export STEAM_BOOTSTRAP_CONFIG="${XDG_CONFIG_HOME:-$HOME/.config}/gamescope/bootstrap.cfg"
