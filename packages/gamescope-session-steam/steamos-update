#!/usr/bin/env bash
# SPDX-License-Identifier: GPL-3.0-or-later
# SteamOS update wrapper for Lenovo Legion Y700 Gen 4 (TB322FC).
set -uo pipefail

for arg in "$@"; do
    case "$arg" in
        --supports-duplicate-detection) exit 0 ;;
    esac
done

# Avoid downloading OS updates during Steam's first-run setup.
login_found=0
shopt -s nullglob
for user_dir in /home/* /var/home/*; do
    if [[ -d "$user_dir" ]] && grep -qs '"AccountName"' "$user_dir/.local/share/Steam/config/loginusers.vdf"; then
        login_found=1
        break
    fi
done
shopt -u nullglob

if (( login_found == 0 )); then
    exit 7
fi

exec /usr/libexec/tb322fc/tb322fc-update "$@"
