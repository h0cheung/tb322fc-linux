             fi
@@ -97,22 +105,15 @@
         ;;
     bind)
         shopt -s nullglob
-        udcs=(/sys/class/udc/*)
-        if ((${#udcs[@]} == 0)); then
-            printf 'armada-mtp: no USB device controller found\n' >&2
+        udcs=("${ARMADA_MTP_UDC_CLASS:-/sys/class/udc}"/*)
+        if ((${#udcs[@]} != 1)); then
+            printf 'armada-mtp: connect to a computer; exactly one USB device controller is required\n' >&2
             exit 1
         fi
         udc_name="${udcs[0]##*/}"
-        role_path="/sys/class/usb_role/${udc_name}-role-switch/role"
-        if [[ ! -e "$role_path" ]]; then
-            role_paths=(/sys/class/usb_role/*/role)
-            role_path="${role_paths[0]:-}"
-        fi
-        if [[ -n "$role_path" ]]; then
-            previous_role="$(<"$role_path")"
-            printf '%s\n%s\n' "$role_path" "$previous_role" > "$role_state"
-            printf 'device' > "$role_path"
-        fi
+        # Elden's per-port roles belong to Type-C/UCSI and are not writable.
+        # Bind only the already registered gadget controller; never force a
