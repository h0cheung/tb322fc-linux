-source /usr/lib/armada/storage-lib
+source "${ARMADA_STORAGE_LIB:-/usr/lib/armada/storage-lib}"
 
 unbind() {
     if [[ -e "$gadget/UDC" && -n "$(<"$gadget/UDC")" ]]; then
@@ -55,8 +55,16 @@
         mkdir "$function"
         ln -s "$function" "$config/ffs.mtp"
         install -d -m 0755 "$ffs"
-        armada_uid="$(id -u armada)"
-        armada_gid="$(id -g armada)"
+        session_user=$("${ARMADA_SESSION_USER_COMMAND:-/usr/libexec/armada/session-user}")
+        armada_uid=$(id -u "$session_user")
+        armada_gid=$(id -g "$session_user")
+        (( armada_uid >= 1000 && armada_uid != 65534 )) || exit 1
+        session_home=$(getent passwd "$session_user" | cut -d: -f6)
+        [[ -d "$session_home" && "$session_home" != *\"* && "$session_home" != *$'\n'* && "$session_home" != *$'\r'* ]] || exit 1
+        runuser -u "$session_user" -- test -r "$session_home" -a -w "$session_home" -a -x "$session_home" || exit 1
+        printf '%s\n' "$session_user" > "$runtime/session-user"
+        export ARMADA_SESSION_USER="$session_user"
+        export ARMADA_MEDIA_ROOT="/run/media/$session_user"
         mount -t functionfs -o "rmode=0500,fmode=0600,uid=$armada_uid,gid=$armada_gid" mtp "$ffs"
         sd_storage=0
         # uMTP cannot escape quoted paths; realpath resolves this non-pinning link.
@@ -69,7 +77,7 @@
                 'loop_on_disconnect 1' \
                 'show_hidden_files 0' \
                 'umask 022' \
-                'storage "/var/home/armada" "Home" "rw"'
