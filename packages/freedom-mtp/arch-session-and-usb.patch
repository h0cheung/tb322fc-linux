-ffs=/dev/ffs-mtp
-runtime=/run/armada-mtp
+ffs=${ARMADA_MTP_FUNCTIONFS_ROOT:-/dev/ffs-mtp}
+runtime=${ARMADA_MTP_RUNTIME:-/run/armada-mtp}
 role_state="$runtime/previous-role"
