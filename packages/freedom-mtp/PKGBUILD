# Maintainer: h0cheung
pkgname=freedom-mtp
pkgver=20261025
pkgrel=1
pkgdesc='On-demand Freedom USB MTP file transfer with Arch session ownership'
arch=(any)
url='https://github.com/mydanyi/armadaos-freedom'
license=(GPL-2.0-or-later)
depends=(bash systemd util-linux coreutils jq armada-control umtp-responder-freedom)
_commit=9788014a0293dc26745b000d02854ad88ef73e88
source=(
    "mtp-gadget::https://raw.githubusercontent.com/mydanyi/armadaos-freedom/$_commit/system_files/usr/libexec/armada/mtp-gadget"
    "storage-lib::https://raw.githubusercontent.com/mydanyi/armadaos-freedom/$_commit/system_files/usr/lib/armada/storage-lib"
    "armada-mtp.service::https://raw.githubusercontent.com/mydanyi/armadaos-freedom/$_commit/system_files/usr/lib/systemd/system/armada-mtp.service"
    arch-session-and-usb.patch
    mtp-session
)
sha256sums=(
    '2ddc127261169150166418a52b4a2647f7392d721bcd56d171b687d18aaaafa9'
    '460dc5d38e6594d09fd03e2c2ce049387fe013b97fd5d48ed1c63bb2b2f2addf'
    '4b55c12d26d0793154c09c8518999308b79ad75dae51f3765c2bce72b419cb77'
    '9048fc1f761b4a8179768ab801ac353e79d6fcd6647d951a3c7a49191a2091c4'
    'bf20284237f7f9b87e221e6d8839231ea6a07d2bb26cfecb695dd448a39b2b95'
)

prepare() {
    # makepkg links flat downloads into srcdir; patch private regular copies.
    for file in mtp-gadget storage-lib armada-mtp.service; do
        cp -- "$srcdir/$file" "$srcdir/$file.regular"
        mv -f -- "$srcdir/$file.regular" "$srcdir/$file"
    done
    patch --batch --fuzz=0 -Np1 -i "$srcdir/arch-session-and-usb.patch"
}

package() {
    install -Dm755 "$srcdir/mtp-gadget" "$pkgdir/usr/libexec/armada/mtp-gadget"
    install -Dm755 "$srcdir/mtp-session" "$pkgdir/usr/libexec/armada/mtp-session"
    install -Dm644 "$srcdir/storage-lib" "$pkgdir/usr/lib/armada/storage-lib"
    install -Dm644 "$srcdir/armada-mtp.service" "$pkgdir/usr/lib/systemd/system/armada-mtp.service"
}
