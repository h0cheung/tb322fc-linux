prepare() {
    for f in upscaling.py upscaling.tsx; do
        install -m644 "$f" "$f.work"
        mv "$f.work" "$f"
    done
    patch -Np1 --fuzz=0 -i optional-render-tools.patch
    install -Dm644 package.json frontend/package.json
    install -Dm644 package-lock.json frontend/package-lock.json
    install -Dm644 plugin.json frontend/game-settings/plugin.json
    install -Dm644 package.json frontend/game-settings/package.json
    install -Dm644 rollup.config.js frontend/game-settings/rollup.config.js
    install -Dm644 tsconfig.json frontend/game-settings/tsconfig.json
    for f in index.tsx launch.ts upscaling.tsx; do
        install -Dm644 "$f" "frontend/game-settings/src/$f"
    done
    for f in GamePicker.tsx launchOptions.ts Tabs.tsx; do
        install -Dm644 "$f" "frontend/shared/$f"
    done
}

build() {
    cd frontend
    npm ci --ignore-scripts --no-audit --no-fund
    npm run typecheck
    npm run build
}

check() {
    NODE_PATH="$srcdir/frontend/node_modules" node test-launch.cjs launch.ts
}

package() {
    local d="$pkgdir/usr/share/decky-plugins/decky-render-tools"
    install -Dm644 main.py plugin.json package.json -t "$d"
    install -Dm644 frontend/game-settings/dist/index.js "$d/dist/index.js"
    install -Dm644 upscaling.py steamlib.py -t "$d/py_modules"
    install -Dm644 LICENSE.upstream "$d/LICENSE"
    install -Dm644 LICENSE.upstream "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
    install -Dm755 render-tools-sync "$pkgdir/usr/lib/decky-loader/render-tools-sync"
    install -Dm644 render-tools.conf "$pkgdir/usr/lib/systemd/system/decky-loader@.service.d/render-tools.conf"
}
