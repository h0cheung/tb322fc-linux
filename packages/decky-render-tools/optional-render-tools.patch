@@ -331,6 +331,19 @@
             "settings": settings}
 
 
+def select_install(appid: int, exe_dir: str, proxy: str) -> dict:
+    """Persist the install choices while off, before the UI can be remounted."""
+    root = steamlib.install_dir(appid)
+    if not root or not os.path.isdir(exe_dir) or not _inside(root, exe_dir):
+        raise ValueError("folder is not inside the game's install directory")
+    if proxy not in PROXIES:
+        raise ValueError(f"unsupported proxy {proxy}")
+    if _find_install(appid, root):
+        raise ValueError("turn OptiScaler off before changing its folder or proxy")
+    _write_json(os.path.join(PARKED, f"{appid}.json"), {"dir": exe_dir, "proxy": proxy})
+    return get_game(appid)
+
+
 def enable(appid: int, exe_dir: str, proxy: str) -> dict:
     root = steamlib.install_dir(appid)
     if not root or not os.path.isdir(exe_dir) or not _inside(root, exe_dir):
