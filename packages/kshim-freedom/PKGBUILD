build() {
  [[ -n ${KSHIM_TOOLS_BUNDLE:-} ]] && return 0
  python "$srcdir/build-tools.py" --source "$srcdir" --crdk-archive "${SRCDEST:-$startdir}/CrDK-b6c3335.tar.gz" --jobs "${JOBS:-$(nproc)}"
}

package() {
  install -d "$pkgdir/usr/lib/kshim-freedom"
  cp -a "$srcdir/kshim-tools/." "$pkgdir/usr/lib/kshim-freedom/"
  for name in kshim-build-boot.py build-kshim-arch.py arch-explicit-layout.patch freedom-sources.json sign-kshim-boot.py init; do
    install -m644 "$srcdir/$name" "$pkgdir/usr/lib/kshim-freedom/$name"
  done
  install -Dm755 "$srcdir/freedom-kernel-update.py" "$pkgdir/usr/bin/freedom-kernel-update"
  install -Dm755 "$srcdir/kshim-android-base-replace.py" "$pkgdir/usr/bin/kshim-android-base-replace"
  install -Dm644 "$srcdir/95-kshim-freedom.hook" "$pkgdir/usr/share/libalpm/hooks/95-kshim-freedom.hook"
  install -Dm644 "$srcdir/60-kshim-freedom-backup.hook" "$pkgdir/usr/share/libalpm/hooks/60-kshim-freedom-backup.hook"
}
