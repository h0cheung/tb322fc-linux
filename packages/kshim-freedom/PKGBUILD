if [[ -n ${KSHIM_TOOLS_BUNDLE:-} ]]; then
  [[ ${KSHIM_TOOLS_SHA256:-} =~ ^[a-f0-9]{64}$ ]] || return 1
  source+=("kshim-tools.tar.zst::file://$KSHIM_TOOLS_BUNDLE")
  sha256sums+=("$KSHIM_TOOLS_SHA256")
