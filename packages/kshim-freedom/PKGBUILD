pkgname=kshim-freedom
pkgver=20261024
pkgrel=4
pkgdesc='Native kShim tools and atomic kernel deployment for Freedom on Elden'
arch=(aarch64)
license=(GPL-3.0-or-later)
options=(!strip !debug !lto)
depends=(python openssl dtc cpio gzip kmod util-linux zstd xz)
makedepends=(git cmake ninja gcc make python-kconfiglib)
_freedom_commit=244b74516d99d06cb0518609ce4b842ab278be8a
