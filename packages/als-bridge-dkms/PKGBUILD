# Maintainer: h0cheung
pkgname=als-bridge-dkms
pkgver=20260929
pkgrel=3
pkgdesc='DKMS kernel module for the Steam ambient-light bridge'
arch=(any)
license=(GPL-2.0-only)
# This source-only package has no ELF files for makepkg to split debug symbols.
options=(!debug)
depends=(dkms)
optdepends=('als-bridge: SensorProxy userspace daemon')
source=(als-bridge.c Makefile dkms.conf)
sha256sums=('b4447e9c5abd53ac5edae6f0b09b619b3f8c7fa41e4632a271be5a89d13da65a' '604c62fd7626cb76a1ad186ec0c3bf7c0808870f997306ceaa49fbed5658a067' 'fb45379e6c34fe0ebeaa862efb6af858c869bd21748191d411a96210835fa730')

package() {
  local dest="$pkgdir/usr/src/als-bridge-$pkgver"
  install -Dm644 "$srcdir/als-bridge.c" "$dest/als-bridge.c"
  install -Dm644 "$srcdir/Makefile" "$dest/Makefile"
  install -Dm644 "$srcdir/dkms.conf" "$dest/dkms.conf"
}
