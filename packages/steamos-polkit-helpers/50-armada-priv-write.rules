// Allow the active wheel user to pkexec steamos-priv-write without a prompt
// (Steam client calls it for GPU clock / backlight writes).
// The upstream file also whitelisted logind inhibit actions for Armada's
// fixed "armada" user; that part does not apply here and was dropped.
polkit.addRule(function(action, subject) {
    if (action.id == "org.freedesktop.policykit.exec" &&
        action.lookup("program") == "/usr/bin/steamos-polkit-helpers/steamos-priv-write" &&
        subject.active && subject.isInGroup("wheel")) {
        return polkit.Result.YES;
    }
});
