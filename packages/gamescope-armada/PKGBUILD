# Maintainer: h0cheung <hcheunh@gmail.com>
# Arch aarch64 build of the OpenGamingCollective (OGC) gamescope fork at the
# revision ArmadaOS ships (3.16.31-ogc1), plus the 25 patches ArmadaOS carries
# on top and three Y700-local patches.
#
# Why not Arch's own gamescope: the Y700's internal DSI panel exposes no EDID,
# so upstream's CDRMConnector::ParseEDID() bails out early and never populates
# ValidDynamicRefreshRates. wlserver then advertises only the single current
# mode, which is why Steam shows no refresh-rate selector at all and the frame
# limiter stops at 120 Hz. ArmadaOS fixes that with a synthetic-EDID path and
# known-display profiles (patches 0002/0003) and layers its HDR / DRM-lease
# work (0004-0017, 0021) and a few arm64 fixes on the same fork. All of those
# are written against this exact fork revision, so the fork is the base rather
# than a backport target. The last three patches are Y700-local: 0027 clamps the
# synthetic EDID's pixel clock (the Y700's 1904x3040@120 runs at 915.6 MHz, past
# EDID's 16-bit 10 kHz field, so without it the whole EDID was dropped and none
# of the above took effect); 0028 writes the session's real refresh range into
# the EDID range descriptor so Steam's slider spans the panel; and 0029 ties the
# SPI digitizer to the internal connector so the panel-orientation transform
# reaches touch.
#
# Renamed build: the package carries -armada and stands in for "gamescope" via
# provides/conflicts/replaces, so a rolling Arch Linux ARM update cannot clobber
# the patched compositor (same scheme as mesa-y700-gen4-git). The file capabilities
# are applied by the rootfs tmpfiles entry, not here, because makepkg runs
# unprivileged.
_pkgname=gamescope
_commit=afd6eac6e1b5045119831b63854bad68ec4fd92c # tag 3.16.31-ogc1
pkgname=gamescope-armada
pkgver=3.16.31.ogc1
pkgrel=1
pkgdesc="SteamOS session compositing window manager (OGC fork, ArmadaOS patches)"
arch=('aarch64')
url="https://github.com/OpenGamingCollective/gamescope"
license=('BSD-2-Clause' 'BSD-3-Clause' 'LicenseRef-Reshade')
