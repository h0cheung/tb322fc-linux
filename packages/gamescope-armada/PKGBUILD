# tb322fc: renamed build; stand in for the repo package, so a rolling Arch
# Linux ARM update cannot clobber the patched compositor. 3.16.31.ogc1 sorts
# above the stock 3.16.31 (the extra .ogc1 segment wins), but provides/conflicts
# still keep the two packages from ever being installed side by side.
provides=('gamescope')
conflicts=('gamescope')
replaces=('gamescope')

prepare() {
    cd "$_pkgname"

    # glm and stb come from wrap files, not git submodules.
    meson subprojects download

    # Repoint every submodule at the pinned source makepkg already unpacked.
    local submodule
    for submodule in src/reshade \
        subprojects/{libdisplay-info,libliftoff,openvr,vkroots,wlroots} \
        thirdparty/SPIRV-Headers; do
        git submodule init "$submodule"
        git config "submodule.$submodule.url" "../${submodule##*/}"
    done
    git -c protocol.file.allow=always submodule update

    # 0020 patches libliftoff, so this has to follow the submodule checkout.
    local patch
    for patch in "$srcdir"/*.patch; do
        msg2 "Applying $(basename "$patch")"
        patch -Np1 -i "$patch"
    done
}

build() {
    # The bundled openvr subproject's CMakeLists predates CMake 4 policy checks.
    export CMAKE_POLICY_VERSION_MINIMUM=3.5

    cd "$_pkgname"
    # wlroots is forced to the subproject too: the fork wants wlroots-0.20 and
    # no distro package provides it.
    arch-meson . build \
        -Dforce_fallback_for=glm,stb,libdisplay-info,libliftoff,vkroots,wlroots \
        -Dpipewire=enabled
    meson compile -C build
}

package() {
    cd "$_pkgname"

    # ReShade effect shaders are runtime data the compositor looks for under
    # <prefix>/share/gamescope/reshade/Shaders.
    install -d "$pkgdir/usr/share/gamescope/reshade"
    cp -r "$srcdir"/GamescopeShaders/* "$pkgdir/usr/share/gamescope/reshade/"
    chmod -R 755 "$pkgdir/usr/share/gamescope"

    meson install -C build --skip-subprojects --destdir "$pkgdir"


    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
    install -Dm644 "$srcdir"/reshade/LICENSE.md "$pkgdir/usr/share/licenses/$pkgname/LICENSE.reshade"
}
