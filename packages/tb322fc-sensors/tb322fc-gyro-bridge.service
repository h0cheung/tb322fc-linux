[Unit]
Description=Lenovo Legion Y700 Gyroscope and Motion Sensor Bridge (DSU and uinput)
Requires=hexagonrpcd-sensors.service
After=hexagonrpcd-sensors.service
ConditionDirectoryNotEmpty=/var/lib/hexagonrpc/sensors/config

[Service]
Type=simple
ExecStart=/usr/bin/tb322fc-gyro-bridge
Restart=always
RestartSec=3s

[Install]
WantedBy=multi-user.target
