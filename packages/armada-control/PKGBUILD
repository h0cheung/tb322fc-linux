# Maintainer: h0cheung <hcheunh@gmail.com>
# The privileged settings daemon behind the armada-control Decky plugin,
# ported from ArmadaOS system_files (usr/libexec/armada/armada-control +
# device-env, usr/lib/armada/{armada_game_tweaks,armada_perf}.py, device
# profiles, usr/share/armada data). Note: device-env, armada_perf.py and the device profiles are owned by
# armada-powerd (shipped there first); this package only adds what it needs.
# armada_session.py is the port's replacement for upstream's assumed single
# user: it discovers the graphical session's account instead of hardcoding
# "armada", and is exposed as /usr/libexec/armada/session-user for the shell
# callers (armada-decky-sync, the sleep-debug hook).
# Upstream: https://github.com/armada-os/armada (GPL-2.0-or-later, Copyright the Armada contributors)
pkgname=armada-control
pkgver=20261029
pkgrel=1
pkgdesc="Armada privileged settings daemon for the armada-control Decky plugin"
arch=('aarch64')
url="https://github.com/armada-os/armada"
license=('GPL-2.0-or-later')
depends=('python' 'python-gobject' 'inputplumber')
makedepends=()
backup=('etc/armada/game-tweaks.json')

source=(
    "armada-control.upstream::https://raw.githubusercontent.com/mydanyi/armadaos-freedom/9788014a0293dc26745b000d02854ad88ef73e88/system_files/usr/libexec/armada/armada-control"
    "armada-game-launch::https://raw.githubusercontent.com/mydanyi/armadaos-freedom/9788014a0293dc26745b000d02854ad88ef73e88/system_files/usr/libexec/armada/armada-game-launch"
    "armada_game_tweaks.py::https://raw.githubusercontent.com/mydanyi/armadaos-freedom/9788014a0293dc26745b000d02854ad88ef73e88/system_files/usr/lib/armada/armada_game_tweaks.py"
    "armada_turnip.py::https://raw.githubusercontent.com/mydanyi/armadaos-freedom/9788014a0293dc26745b000d02854ad88ef73e88/system_files/usr/lib/armada/armada_turnip.py"
    "env-presets.json::https://raw.githubusercontent.com/mydanyi/armadaos-freedom/9788014a0293dc26745b000d02854ad88ef73e88/system_files/usr/share/armada/env-presets.json"
    arch-control-compat.patch
)
sha256sums=(
    'b22e00c35ea576d00a21c9cb296d91dccef8e566c6110e21d613f8b9f7320939'
    '6f9131f9db3b340c5be2d2545d988072cb50ebeec9348431f13508ab27e703ca'
    'fef819d936e072fb6c71a0d2e2a139e5c2ff9ccc35e3b2ff8df789096e6f7443'
    'ca4d3ea19aeff9cda156a878d26328c60bc6f969d1ef4ff649bb6a327a8a4fc9'
    'f26d1b9cccbc65142f106c6c94d5e1814f43721b7b30e57817fea6242087c5cc'
    '96ef57deb5910ef5262d8e96d4b2f699c135923bab0115dac2f441512d2bbe10'
)
prepare() {
    cp "$srcdir/armada-control.upstream" "$srcdir/armada-control"
    patch -Np1 --fuzz=0 -d "$srcdir" -i "$srcdir/arch-control-compat.patch"
}

package() {
    cd "$startdir"
    install -Dm755 "$srcdir/armada-control" "$pkgdir/usr/libexec/armada/armada-control"
    install -Dm755 "$srcdir/armada-game-launch" "$pkgdir/usr/libexec/armada/armada-game-launch"
    install -Dm644 "$srcdir/armada_turnip.py" "$pkgdir/usr/lib/armada/armada_turnip.py"
    install -Dm644 "$srcdir/env-presets.json" "$pkgdir/usr/share/armada/env-presets.json"
    install -Dm755 armada-power "$pkgdir/usr/bin/armada-power"
    install -Dm644 "$srcdir/armada_game_tweaks.py" "$pkgdir/usr/lib/armada/armada_game_tweaks.py"
    install -Dm755 armada_session.py "$pkgdir/usr/lib/armada/armada_session.py"
    # Shell callers want a command, not a python -c one-liner.
    ln -s ../../lib/armada/armada_session.py "$pkgdir/usr/libexec/armada/session-user"
    install -Dm644 armada-control.service \
        "$pkgdir/usr/lib/systemd/system/armada-control.service"

    # Controller type selection: the daemon side (controller-type), the
    # calibration overlay helper, the boot-time apply unit, and the udev rules
    # that give Steam access to the emulated Deck hidraw and /dev/uinput.
    install -Dm755 controller-type "$pkgdir/usr/libexec/armada/controller-type"
    install -Dm755 inputplumber-intercept "$pkgdir/usr/libexec/armada/inputplumber-intercept"
    install -Dm644 armada-controller-type.service \
        "$pkgdir/usr/lib/systemd/system/armada-controller-type.service"
    install -Dm644 70-armada-inputplumber.rules \
        "$pkgdir/usr/lib/udev/rules.d/70-armada-inputplumber.rules"
    install -Dm644 70-armada-uinput.rules \
        "$pkgdir/usr/lib/udev/rules.d/70-armada-uinput.rules"

    # Data the plugin backend and daemon read (game tweak defaults, FEX
    # contract, env presets).
    install -d "$pkgdir/usr/share/armada"
    install -m644 usr-share/game-tweaks.json "$pkgdir/usr/share/armada/game-tweaks.json"
    install -m644 usr-share/fex-profiles.json "$pkgdir/usr/share/armada/fex-profiles.json"

    install -d "$pkgdir/etc/armada"
}
