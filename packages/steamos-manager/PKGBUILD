prepare() {
    cd "$pkgname"
    local patch
    for patch in "$srcdir"/0*.patch; do
        patch -Np1 -i "$patch"
    done
    # Armada replaces upstream's platform.toml with an empty one on purpose:
    # every key left out disables that upstream hardware interface, and none
    # of upstream's are ours to serve. Our hardware side is served by
    # armada-powerd and relayed through /etc/steamos-manager/remotes.d/.
    install -m644 "$srcdir/platform.toml" data/platform.toml
    install -m644 "$srcdir/sm8750.toml" data/devices/sm8750.toml
    patch -Np1 --fuzz=0 -i "$srcdir/elden-device.patch"
}

build() {
    cd "$pkgname"
    export CARGO_TARGET_DIR=target
    cargo build --release --locked
}

package() {
    cd "$pkgname"

    # Mirror the upstream Makefile's install rules, including its install -d
    # stanza: the plain install -m644 lines below rely on these directories.
    install -d -m0755 "$pkgdir/usr/share/dbus-1/interfaces/" \
                      "$pkgdir/usr/share/dbus-1/services/" \
                      "$pkgdir/usr/share/dbus-1/system-services/" \
                      "$pkgdir/usr/share/dbus-1/system.d/" \
                      "$pkgdir/usr/share/steamos-manager/remotes.d/" \
                      "$pkgdir/usr/lib/systemd/system/" \
                      "$pkgdir/usr/lib/systemd/user/" \
                      "$pkgdir/etc/steamos-manager/remotes.d/"

    install -Dm755 target/release/steamos-manager "$pkgdir/usr/lib/steamos-manager"
    install -Dm755 target/release/steamosctl "$pkgdir/usr/bin/steamosctl"

    install -d "$pkgdir/usr/share/steamos-manager/devices"
    install -m644 data/devices/* "$pkgdir/usr/share/steamos-manager/devices/"
    install -m644 data/platform.toml "$pkgdir/usr/share/steamos-manager/"
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/steamos-manager/LICENSE"

    install -Dm644 -t "$pkgdir/usr/share/dbus-1/interfaces" data/interfaces/*

    install -m644 data/system/com.steampowered.SteamOSManager1.service \
        "$pkgdir/usr/share/dbus-1/system-services/"
    install -m644 data/system/com.steampowered.SteamOSManager1.conf \
        "$pkgdir/usr/share/dbus-1/system.d/"
    install -m644 data/system/steamos-manager.service "$pkgdir/usr/lib/systemd/system/"

    install -m644 data/user/com.steampowered.SteamOSManager1.service \
        "$pkgdir/usr/share/dbus-1/services/"
    # orca.service is shipped by the 'orca' package (same unit name); installing
    # our copy conflicts with it and would delete the file on package removal.
    for unit in steamos-manager steamos-manager-session-cleanup \
                steamos-manager-configure-cecd; do
        install -m644 "data/user/$unit.service" "$pkgdir/usr/lib/systemd/user/"
    done

    # Our remotes.d relay hands PerformanceProfile1, GpuPerformanceLevel1 and
    # CpuScaling1 to armada-powerd, which owns the actual hardware policy.
    install -Dm644 "$srcdir/remotes.d-armada.toml" \
        "$pkgdir/etc/steamos-manager/remotes.d/armada.toml"
    install -d "$pkgdir/usr/share/steamos-manager/remotes.d"
}
