prepare() {
    cd "$srcdir/uMTP-Responder-$_commit"
    for file in "$srcdir/"*.patch; do
        patch --batch --fuzz=0 -Np1 -i "$file"
    done
}

build() {
    cd "$srcdir/uMTP-Responder-$_commit"
    make CFLAGS="$CFLAGS -I./inc -Wall -DSYSTEMD_NOTIFY" LDFLAGS="$LDFLAGS -lpthread -lrt -lsystemd"
}

package() {
    install -Dm755 "$srcdir/uMTP-Responder-$_commit/umtprd" "$pkgdir/usr/bin/umtprd"
    install -Dm644 "$srcdir/uMTP-Responder-$_commit/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
