+void dpu_plane_calc_perf(const struct drm_plane_state *state,
+		const struct drm_display_mode *mode, u64 *bw, u64 *clk);
+
 struct drm_plane *dpu_plane_init(struct drm_device *dev,
 		uint32_t pipe, enum drm_plane_type type,
 		unsigned long possible_crtcs);
diff --git a/drivers/gpu/drm/msm/disp/dpu1/dpu_core_perf.c b/drivers/gpu/drm/msm/disp/dpu1/dpu_core_perf.c
--- a/drivers/gpu/drm/msm/disp/dpu1/dpu_core_perf.c
+++ b/drivers/gpu/drm/msm/disp/dpu1/dpu_core_perf.c
@@ -17,6 +17,7 @@
 #include "dpu_trace.h"
 #include "dpu_crtc.h"
 #include "dpu_core_perf.h"
+#include "dpu_plane.h"
 
 /**
  * enum dpu_perf_mode - performance tuning mode
@@ -74,8 +75,7 @@
 	 * bandwidth of the frame being committed.  Other machines keep the
 	 * committed-plane aggregation.
 	 */
-	if (of_machine_is_compatible("lenovo,baldur") ||
-	    of_machine_is_compatible("lenovo,elden")) {
+	if (of_machine_is_compatible("lenovo,baldur")) {
 		drm_atomic_crtc_state_for_each_plane_state(plane, plane_state,
 							   state) {
 			pstate = to_dpu_plane_state(plane_state);
@@ -140,6 +140,28 @@
 	return to_dpu_kms(priv->kms);
 }
 
+static void dpu_core_perf_calc_atomic(const struct dpu_perf_cfg *cfg,
+		struct drm_crtc_state *state, struct dpu_core_perf_params *perf)
+{
+	const struct drm_display_mode *mode = &state->adjusted_mode;
+	const struct drm_plane_state *plane_state;
+	struct drm_plane *plane;
+	u64 bw, clk;
+	u64 mode_clk = (u64)mode->vtotal * mode->hdisplay * drm_mode_vrefresh(mode);
+
+	perf->bw_ctl = 0;
+	drm_atomic_crtc_state_for_each_plane_state(plane, plane_state, state) {
+		dpu_plane_calc_perf(plane_state, mode, &bw, &clk);
+		perf->bw_ctl += bw;
+		mode_clk = max(mode_clk, clk);
+	}
+	if (cfg->bw_inefficiency_factor) {
+		perf->bw_ctl *= cfg->bw_inefficiency_factor;
+		do_div(perf->bw_ctl, 100);
+	}
+	perf->core_clk_rate = dpu_core_perf_adjusted_mode_clk(mode_clk, cfg);
+}
+
 static void _dpu_core_perf_calc_crtc(const struct dpu_core_perf *core_perf,
 				     struct drm_crtc *crtc,
 				     struct drm_crtc_state *state,
@@ -152,9 +174,13 @@
 		return;
 	}
 
-	perf->bw_ctl = _dpu_core_perf_calc_bw(perf_cfg, crtc, state);
+	if (of_machine_is_compatible("lenovo,elden")) {
+		dpu_core_perf_calc_atomic(perf_cfg, state, perf);
+	} else {
+		perf->bw_ctl = _dpu_core_perf_calc_bw(perf_cfg, crtc, state);
+		perf->core_clk_rate = _dpu_core_perf_calc_clk(perf_cfg, crtc, state);
+	}
 	perf->max_per_pipe_ib = perf_cfg->min_dram_ib;
-	perf->core_clk_rate = _dpu_core_perf_calc_clk(perf_cfg, crtc, state);
 	DRM_DEBUG_ATOMIC(
 		"crtc=%d clk_rate=%llu core_ib=%u core_ab=%u\n",
 			crtc->base.id, perf->core_clk_rate,
