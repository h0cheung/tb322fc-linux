pkgname=freedom-diagnostics
pkgver=20261025
pkgrel=1
pkgdesc='Freedom sleep diagnostics, wake ledger and bounded device crash capture'
arch=(any)
url='https://github.com/mydanyi/armadaos-freedom'
license=(GPL-2.0-or-later)
depends=(bash python systemd coreutils util-linux)
_commit=9788014a0293dc26745b000d02854ad88ef73e88
source=(
    "armada-sleep-debug::https://raw.githubusercontent.com/mydanyi/armadaos-freedom/$_commit/system_files/usr/bin/armada-sleep-debug"
    "armada_sleep_debug.py::https://raw.githubusercontent.com/mydanyi/armadaos-freedom/$_commit/system_files/usr/lib/armada/armada_sleep_debug.py"
    "40-armada-wake-ledger::https://raw.githubusercontent.com/mydanyi/armadaos-freedom/$_commit/system_files/usr/lib/systemd/system-sleep/40-armada-wake-ledger"
    "save-devcoredump::https://raw.githubusercontent.com/mydanyi/armadaos-freedom/$_commit/system_files/usr/libexec/armada/save-devcoredump"
    "70-armada-devcoredump.rules::https://raw.githubusercontent.com/mydanyi/armadaos-freedom/$_commit/system_files/usr/lib/udev/rules.d/70-armada-devcoredump.rules"
    "armada-save-devcoredump@.service::https://raw.githubusercontent.com/mydanyi/armadaos-freedom/$_commit/system_files/usr/lib/systemd/system/armada-save-devcoredump@.service"
    bounded-capture.patch
    freedom-diagnostics.conf
)
sha256sums=(
    '593267b5d0bd7f125bf37f2b5b7239879af8e8f8c83275d161e633357580111f'
    '9de96cb6ecee848839ec985311e8707ca75db6ba0d8c8c71e14a7e44e53a1ac8'
