prepare() {
    # makepkg links flat downloads into srcdir; patch private regular copies.
    for file in save-devcoredump 40-armada-wake-ledger armada_sleep_debug.py; do
        cp -- "$srcdir/$file" "$srcdir/$file.regular"
        mv -f -- "$srcdir/$file.regular" "$srcdir/$file"
    done
    patch --batch --fuzz=0 -Np1 -i "$srcdir/bounded-capture.patch"
}

package() {
    install -Dm755 "$srcdir/armada-sleep-debug" "$pkgdir/usr/bin/armada-sleep-debug"
    install -Dm644 "$srcdir/armada_sleep_debug.py" "$pkgdir/usr/lib/armada/armada_sleep_debug.py"
    install -Dm755 "$srcdir/40-armada-wake-ledger" "$pkgdir/usr/lib/systemd/system-sleep/40-armada-wake-ledger"
    install -Dm755 "$srcdir/save-devcoredump" "$pkgdir/usr/libexec/armada/save-devcoredump"
    install -Dm644 "$srcdir/70-armada-devcoredump.rules" "$pkgdir/usr/lib/udev/rules.d/70-armada-devcoredump.rules"
    install -Dm644 "$srcdir/armada-save-devcoredump@.service" "$pkgdir/usr/lib/systemd/system/armada-save-devcoredump@.service"
    install -Dm644 "$srcdir/freedom-diagnostics.conf" "$pkgdir/usr/lib/tmpfiles.d/freedom-diagnostics.conf"
}
