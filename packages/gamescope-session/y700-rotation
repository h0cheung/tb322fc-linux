# Sourced only for the Y700 Gen4 by device-quirks.
y700_rotation_policy() {
    local kernel_dir=${1:-/usr/lib/modules/$(uname -r)}
    # Keep the validated path until DPU scanout has been tested on this panel.
    if [[ $(uname -r) == *-freedom* ]]; then
        FORCE_COMPOSITION_ROTATION=1
    fi
    if [[ ${Y700_ROTATION:-gpu} == dpu ]]; then
        if [[ -f $kernel_dir/freedom-dpu-rotation ]]; then
            FORCE_COMPOSITION_ROTATION=0
            # Matches the existing portrait-panel auto orientation (270 degrees).
            ORIENTATION=${ORIENTATION:-right}
        else
            FORCE_COMPOSITION_ROTATION=1
            printf '%s\n' 'Y700: DPU rotation needs a matching updated Freedom kernel; using GPU rotation.' >&2
        fi
    fi
}
