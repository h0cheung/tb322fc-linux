# Y700 Gen4 (tb322fc-linux) tracking mesa upstream *main* (not a release tarball).
# Like mesa-y700-gen4 it renames every split package to -y700-gen4-git and stands
# in for the repo package via exact-version provides + conflicts/replaces, but the
# source is the git tree so we get the latest Adreno 830 (a8xx) fixes as they land.
# Carried patches: turnip sparse-sync disable, ir3 bindless-UBO lowering disable,
# Banners a8xx cube-coord sanitize + bindless invalidate, and the a8xx shared-mem
# bump (32->64 KiB). The a830 chip-id patch is dropped: main already has it.
pkgbase=mesa-y700-gen4-git
pkgname=(
  mesa-y700-gen4-git
  opencl-mesa-y700-gen4-git
  vulkan-asahi-y700-gen4-git
  vulkan-broadcom-y700-gen4-git
  vulkan-dzn-y700-gen4-git
  vulkan-freedreno-y700-gen4-git
  vulkan-gfxstream-y700-gen4-git
  vulkan-intel-y700-gen4-git
  vulkan-nouveau-y700-gen4-git
  vulkan-panfrost-y700-gen4-git
  vulkan-powervr-y700-gen4-git
  vulkan-radeon-y700-gen4-git
  vulkan-swrast-y700-gen4-git
  vulkan-virtio-y700-gen4-git
  vulkan-mesa-implicit-layers-y700-gen4-git
  vulkan-mesa-layers-y700-gen4-git
  mesa-docs-y700-gen4-git
)
# Placeholder only; pkgver() recomputes it from the checked-out git tree. It
# must be non-empty or makepkg aborts its early lint before pkgver() runs.
pkgver=26.3.0_devel.0.0000000.0000000
pkgrel=1
epoch=1
pkgdesc="Open-source OpenGL drivers"
url="https://www.mesa3d.org/"
arch=(aarch64 x86_64)
license=("MIT AND BSD-3-Clause AND SGI-B-2.0")
makedepends=(
  git
  curl
  clang
  directx-headers
  expat
  glibc
  libdisplay-info
  libdrm
  libelf
  libgcc
  libglvnd
  libpng
  libstdc++
  libva
  libx11
  libxcb
  libxext
  libxml2
  libxrandr
  libxshmfence
  libxxf86vm
  llvm
  llvm-libs
  lm_sensors
  rust
  spirv-llvm-translator
  spirv-tools
  systemd-libs
  vulkan-icd-loader
  wayland
  xcb-util-keysyms
  zlib
  zstd

  # shared between mesa and lib32-mesa
  cbindgen
  clang
  cmake
  elfutils
  glslang
  libclc
  meson
  python-mako
  python-packaging
  python-ply
  python-pycparser
  python-yaml
  rust-bindgen
  wayland-protocols
  xorgproto

  # mesa-only deps

  # html-docs
)
options=(
  # GCC 14 LTO causes segfault in LLVM under si_llvm_optimize_module
  # https://gitlab.freedesktop.org/mesa/mesa/-/issues/11140
  #
  # In general, upstream considers LTO to be broken until explicit notice.
  !lto
)
# Pin the build to a specific mesa commit by exporting MESA_GIT_COMMIT=<hash>
# before building; leave it unset to track the latest main. Either way pkgver()
# is computed from the actually-checked-out tree (see pkgver()), so a pinned
# commit is always reflected in the resulting package version.
_mesa_git_src="mesa::git+https://gitlab.freedesktop.org/mesa/mesa.git"
if [[ -n ${MESA_GIT_COMMIT:-} ]]; then
  _mesa_git_src+="#commit=$MESA_GIT_COMMIT"
else
  _mesa_git_src+="#branch=main"
fi
source=(
  "$_mesa_git_src"
  0001-disable-turnip-sparse-sync.patch
  0003-ir3-disable-bindless-ubo-const-lowering.patch
  0004-a8xx-cube-coord-sanitize.patch
  0005-a8xx-bindless-invalidate.patch
  0006-a8xx-shared-mem.py
)
# git source + local patches/scripts; checksums are not meaningful here.
sha256sums=('SKIP'
            'SKIP'
            'SKIP'
            'SKIP'
            'SKIP'
            'SKIP')

# Generate the version from the checked-out git tree, AUR-style:
#   <VERSION from tree, dashes->underscores>.<commit count>.<short hash>.<patch hash>
# The patch hash makes the version bump when any carried patch changes, so
# makepkg always rebuilds instead of reusing a stale git checkout.
pkgver() {
  cd mesa
  local ver
  ver=$(<VERSION)
  ver=${ver//-/_}

  local _patchhash=""
  local _patchfile
  for _patchfile in "${source[@]}"; do
    _patchfile="${_patchfile%%::*}"
    _patchfile="${_patchfile##*/}"
    [[ $_patchfile = *.patch ]] || continue
    _patchhash+="$(md5sum "$srcdir/$_patchfile" | cut -c1-32)"
  done
  _patchhash="$(printf '%s' "$_patchhash" | md5sum | cut -c1-7)"

  printf '%s.%s.%s.%s' "$ver" "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)" "$_patchhash"
}

# https://docs.mesa3d.org/relnotes.html

prepare() {
  cd mesa

  local src
  for src in "${source[@]}"; do
    src="${src%%::*}"
    src="${src##*/}"
    src="${src%.zst}"
    [[ $src = *.patch ]] || continue
    echo "Applying patch $src..."
    patch -Np1 < "../$src"
  done

  # Banners-Turnip: bump A8xx (and every device's) cs_shared_mem_size
  # 32 KiB -> 64 KiB. Global string replace in freedreno_devices.py; idempotent
  # and safe if upstream already changed the value. Runs after the patches so
  # their hunks land first.
  if [[ -f ../0006-a8xx-shared-mem.py ]]; then
    echo "Running 0006-a8xx-shared-mem.py..."
    python ../0006-a8xx-shared-mem.py
  fi

  # Fetch the Rust crates that NVK / rusticl / teflon need as Meson subprojects.
  # We read the *-rs.wrap files present in the checked-out tree so the exact
  # crate set tracks whatever main requires (unlike a hard-coded list). They are
  # dropped into subprojects/packagecache, which Meson consults by default.
  local _wrap _url _fn
  mkdir -p subprojects/packagecache
  for _wrap in subprojects/*-rs.wrap; do
    [[ -e "$_wrap" ]] || continue
    _url=$(sed -n 's/^source_url[[:space:]]*=[[:space:]]*//p' "$_wrap")
    _fn=$(sed -n 's/^source_filename[[:space:]]*=[[:space:]]*//p' "$_wrap")
    [[ -n $_url && -n $_fn ]] || continue
    [[ -f "subprojects/packagecache/$_fn" ]] && continue
    echo "Fetching rust subproject $_fn ..."
    curl -fL "$_url" -o "subprojects/packagecache/$_fn"
  done

  # mesa main also needs git-based subprojects (e.g. venus-protocol, pulled in
  # by freedreno-kmds=...,virtio). arch-meson forces wrap_mode=nodownload and
  # these have no system package, so clone them here. We read every wrap-git in
  # the tree so the exact set tracks whatever main requires.
  local _gwrap _gurl _gdir _grev
  for _gwrap in subprojects/*.wrap; do
    [[ -e "$_gwrap" ]] || continue
    [[ $(sed -n 's/^\[\(wrap-[a-z]*\)\]/\1/p' "$_gwrap") = wrap-git ]] || continue
    _gurl=$(sed -n 's/^url[[:space:]]*=[[:space:]]*//p' "$_gwrap")
    _gdir=$(sed -n 's/^directory[[:space:]]*=[[:space:]]*//p' "$_gwrap")
    _grev=$(sed -n 's/^revision[[:space:]]*=[[:space:]]*//p' "$_gwrap")
    [[ -n $_gurl && -n $_gdir && -n $_grev ]] || continue
    [[ -d "subprojects/$_gdir" ]] && continue
    echo "Cloning git subproject $_gdir @ $_grev ..."
    git clone --depth 1 --branch "$_grev" "$_gurl" "subprojects/$_gdir" || \
      echo "WARNING: failed to clone $_gdir; configure will fail if it is required"
  done
}

build() {
  # shellcheck disable=SC2054
  local meson_options=(
    --optimization 2
    -D amdgpu-virtio=true
    -D android-libbacktrace=disabled
    -D b_ndebug=true
    -D freedreno-kmds=msm,virtio
    -D gallium-drivers=all
    -D gallium-extra-hud=true
    -D gallium-mediafoundation=disabled
    -D gallium-rusticl-enable-drivers=asahi,freedreno,panfrost,radeonsi
    -D gallium-rusticl=true
    -D gles1=disabled
    -D html-docs=disabled
    -D intel-rt=disabled
    -D intel-virtio-experimental=true
    -D libunwind=disabled
    -D microsoft-clc=disabled
    -D teflon=true
    -D video-codecs=all
    -D vulkan-drivers=amd,intel,intel_hasvk,swrast,freedreno,panfrost,virtio,broadcom,imagination,microsoft-experimental,nouveau,asahi,gfxstream
    -D vulkan-layers=device-select,intel-nullhw,overlay,screenshot,anti-lag,vram-report-limit
    -D vulkan-loader-rpath=
    -D vulkan-manifest-per-architecture=false
  )

  # Bake the final package version into the tree's VERSION so the driver reports
  # a unique version per build; Chromium otherwise keeps a stale GPU cache
  # (https://bugs.launchpad.net/ubuntu/+source/chromium-browser/+bug/2020604).
  # Done here (not in prepare) because pkgver() reads VERSION and must see the
  # pristine upstream value.
  echo "${pkgver}-arch${epoch}.${pkgrel}" >mesa/VERSION

  # Inject subproject packages (Rust crates fetched in prepare())
  export MESON_PACKAGE_CACHE_DIR="$srcdir/mesa/subprojects/packagecache"

  arch-meson mesa build "${meson_options[@]}"
  meson compile -C build
}

_pick() {
  local p="$1" f d; shift
  for f; do
    [[ -e "$f" ]] || continue
    d="$srcdir/$p/${f#$pkgdir/}"
    mkdir -p "$(dirname "$d")"
    mv -v "$f" "$d"
    rmdir -p --ignore-fail-on-non-empty "$(dirname "$f")"
  done
}

package_mesa-y700-gen4-git() {
  depends=(
    expat
    glibc
    libdrm
    libelf
    libgcc
    libglvnd
    libstdc++
    libx11
    libxcb
    libxext
    libxshmfence
    libxxf86vm
    llvm-libs
    lm_sensors
    spirv-tools
    wayland
    zlib
    zstd
  )
  optdepends=("opengl-man-pages: for the OpenGL API man pages")
  provides=(
    "libva-mesa-driver=$epoch:$pkgver-$pkgrel"
    "mesa-libgl=$epoch:$pkgver-$pkgrel"
    libva-driver
    opengl-driver
  )
  conflicts=(
    'libva-mesa-driver<1:24.2.7-1'
    'mesa-libgl<17.0.1-2'
  )
  replaces=(
    'libva-mesa-driver<1:24.2.7-1'
    'mesa-libgl<17.0.1-2'
  )

  # tb322fc: renamed build; stand in for the repo package at the same version
  provides+=("mesa=$epoch:$pkgver-$pkgrel")
  conflicts+=(mesa mesa-y700-gen4)
  replaces+=(mesa mesa-y700-gen4)

  meson install -C build --destdir "$pkgdir" --no-rebuild

  (
    local libdir=usr/lib

    cd "$pkgdir"

    _pick opencl $libdir/libRusticlOpenCL*
    _pick opencl etc/OpenCL/vendors/rusticl.icd

    _pick vkasahi $libdir/libvulkan_asahi.so
    _pick vkasahi usr/share/vulkan/icd.d/asahi_icd.json

    _pick vkbrcom $libdir/libvulkan_broadcom.so
    _pick vkbrcom usr/share/vulkan/icd.d/broadcom_icd.json

    _pick vkd3d12 $libdir/libvulkan_dzn.so
    _pick vkd3d12 $libdir/libspirv_to_dxil.*
    _pick vkd3d12 usr/bin/spirv2dxil
    _pick vkd3d12 usr/share/vulkan/icd.d/dzn_icd.json

    _pick vkfdreno $libdir/libvulkan_freedreno.so
    _pick vkfdreno usr/share/vulkan/icd.d/freedreno_icd.json

    _pick vkgfxstr $libdir/libvulkan_gfxstream.so
    _pick vkgfxstr usr/share/vulkan/icd.d/gfxstream_vk_icd.json

    _pick vkintel $libdir/libvulkan_intel{,_hasvk}.so
    _pick vkintel usr/share/vulkan/icd.d/intel{,_hasvk}_icd.json

    _pick vknvidia $libdir/libvulkan_nouveau.so
    _pick vknvidia usr/share/vulkan/icd.d/nouveau_icd.json

    _pick vkpfrost $libdir/libvulkan_panfrost.so
    _pick vkpfrost usr/share/vulkan/icd.d/panfrost_icd.json

    _pick vkpowrvr $libdir/libvulkan_powervr_mesa.so
    _pick vkpowrvr usr/share/vulkan/icd.d/powervr_mesa_icd.json

    _pick vkradeon $libdir/libvulkan_radeon.so
    _pick vkradeon usr/share/drirc.d/00-radv-defaults.conf
    _pick vkradeon usr/share/vulkan/icd.d/radeon_icd.json

    _pick vkswrast $libdir/libvulkan_lvp.so
    _pick vkswrast usr/share/vulkan/icd.d/lvp_icd.json

    _pick vkvirtio $libdir/libvulkan_virtio.so
    _pick vkvirtio usr/share/vulkan/icd.d/virtio_icd.json

    _pick vkdevice $libdir/libVkLayer_MESA_anti_lag.so
    _pick vkdevice $libdir/libVkLayer_MESA_device_select.so
    _pick vkdevice usr/share/vulkan/implicit_layer.d

    _pick vklayer $libdir/libVkLayer_*.so
    _pick vklayer usr/bin/mesa-*-control.py
    _pick vklayer usr/share/vulkan/explicit_layer.d

    _pick docs usr/share/doc

    # indirect rendering
    ln -sr $libdir/libGLX_{mesa,indirect}.so.0
  )

  install -Dm644 mesa/docs/license.rst -t "$pkgdir/usr/share/licenses/$pkgname"
}

package_opencl-mesa-y700-gen4-git() {
  pkgdesc="Open-source OpenCL drivers"
  depends=(
    clang
    expat
    glibc
    libdrm
    libelf
    libgcc
    libstdc++
    llvm-libs
    spirv-llvm-translator
    spirv-tools
    zlib
    zstd

    libclc # For /usr/share/clc/
  )
  optdepends=("opencl-headers: headers necessary for OpenCL development")
  provides=(opencl-driver)
  replaces=(
    "opencl-clover-mesa<=1:25.0.5-1"
    "opencl-rusticl-mesa<=1:25.0.5-1"
  )
  conflicts=(
    opencl-clover-mesa
    opencl-rusticl-mesa
  )

  # tb322fc: renamed build; stand in for the repo package at the same version
  provides+=("opencl-mesa=$epoch:$pkgver-$pkgrel")
  conflicts+=(opencl-mesa opencl-mesa-y700-gen4)
  replaces+=(opencl-mesa opencl-mesa-y700-gen4)

  mv opencl/* "$pkgdir"

  install -Dm644 mesa/docs/license.rst -t "$pkgdir/usr/share/licenses/$pkgname"
}

