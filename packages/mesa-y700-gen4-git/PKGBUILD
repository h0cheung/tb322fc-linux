    libdisplay-info
    libdrm
    libgcc
    libstdc++
    libx11
    libxcb
    libxshmfence
    spirv-tools
    systemd-libs
    vulkan-icd-loader
    vulkan-mesa-implicit-layers-y700-gen4-git
    wayland
    xcb-util-keysyms
    zlib
    zstd
  )
  optdepends=("vulkan-mesa-layers-y700-gen4-git: additional vulkan layers")
  provides=(vulkan-driver)

  # tb322fc: renamed build; stand in for the repo package at the same version
  provides+=("vulkan-powervr=$epoch:$pkgver-$pkgrel")
  conflicts+=(vulkan-powervr vulkan-powervr-y700-gen4)
  replaces+=(vulkan-powervr vulkan-powervr-y700-gen4)

  mv vkpowrvr/* "$pkgdir"

  install -Dm644 mesa/docs/license.rst -t "$pkgdir/usr/share/licenses/$pkgname"
}

