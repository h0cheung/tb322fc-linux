package_mesa-docs-y700-gen4-git() {
  pkgdesc="Mesa's documentation"

  # tb322fc: renamed build; stand in for the repo package at the same version
  provides+=("mesa-docs=$epoch:$pkgver-$pkgrel")
  conflicts+=(mesa-docs mesa-docs-y700-gen4)
  replaces+=(mesa-docs mesa-docs-y700-gen4)

  if [[ -d docs && "$(ls -A docs 2>/dev/null)" ]]; then
    mv docs/* "$pkgdir"
  else
    mkdir -p "$pkgdir/usr/share/doc/mesa"
    echo "Mesa documentation" > "$pkgdir/usr/share/doc/mesa/README"
  fi

  install -Dm644 mesa/docs/license.rst -t "$pkgdir/usr/share/licenses/$pkgname"
}

