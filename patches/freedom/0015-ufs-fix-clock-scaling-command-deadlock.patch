From: Joonhoe Kim <26rote@gmail.com>
Date: Fri, 16 Oct 2026 21:46:08 +0900
Subject: [PATCH] scsi: ufs: core: Fix a deadlock between clock scaling and device commands

Device management commands hold clk_scaling_lock for reading and use
blk_execute_rq() on the pseudo SCSI device. Quiescing the shared tagset
before taking the lock for writing can prevent such a command from ever
being dispatched while the writer waits for it to finish.

Take the clock-scaling lock (and wb_mutex where required) before quiescing
the tagset, and undo those operations in reverse order. Apply the same
ordering to the command-pause helpers. The existing internal-command
error-recovery fix addresses a different caller of tagset quiescing.

Backport: refresh context for the pinned Freedom kernel; it does not have
the newer function lock annotations. Preserve the upstream code changes.

Fixes: 08b12cda6c44 ("scsi: ufs: core: Switch to scsi_get_internal_cmd()")
Fixes: dc5dcac53278 ("scsi: ufs: core: Add helpers to pause and resume command processing")
Link: https://lore.kernel.org/all/20261016124608.46-1-26rote@gmail.com/
Link: https://lists.openwall.net/linux-kernel/2026/10/16/1633
Link: https://lkml.iu.edu/2610.2/06519.html
Signed-off-by: Joonhoe Kim <26rote@gmail.com>
---
diff --git a/drivers/ufs/core/ufshcd.c b/drivers/ufs/core/ufshcd.c
--- a/drivers/ufs/core/ufshcd.c
+++ b/drivers/ufs/core/ufshcd.c
@@ -1358,13 +1358,13 @@
 	int ret = 0;
 
 	mutex_lock(&hba->host->scan_mutex);
+	down_write(&hba->clk_scaling_lock);
 	blk_mq_quiesce_tagset(&hba->host->tag_set);
-	down_write(&hba->clk_scaling_lock);
 
 	if (ufshcd_wait_for_pending_cmds(hba, timeout_us)) {
 		ret = -EBUSY;
+		blk_mq_unquiesce_tagset(&hba->host->tag_set);
 		up_write(&hba->clk_scaling_lock);
-		blk_mq_unquiesce_tagset(&hba->host->tag_set);
 		mutex_unlock(&hba->host->scan_mutex);
 	}
 
@@ -1379,8 +1379,8 @@
  */
 void ufshcd_resume_command_processing(struct ufs_hba *hba)
 {
+	blk_mq_unquiesce_tagset(&hba->host->tag_set);
 	up_write(&hba->clk_scaling_lock);
-	blk_mq_unquiesce_tagset(&hba->host->tag_set);
 	mutex_unlock(&hba->host->scan_mutex);
 }
 
@@ -1454,16 +1454,16 @@
 	 * clock scaling is in progress
 	 */
 	mutex_lock(&hba->host->scan_mutex);
-	blk_mq_quiesce_tagset(&hba->host->tag_set);
 	mutex_lock(&hba->wb_mutex);
 	down_write(&hba->clk_scaling_lock);
+	blk_mq_quiesce_tagset(&hba->host->tag_set);
 
 	if (!hba->clk_scaling.is_allowed ||
 	    ufshcd_wait_for_pending_cmds(hba, timeout_us)) {
 		ret = -EBUSY;
+		blk_mq_unquiesce_tagset(&hba->host->tag_set);
 		up_write(&hba->clk_scaling_lock);
 		mutex_unlock(&hba->wb_mutex);
-		blk_mq_unquiesce_tagset(&hba->host->tag_set);
 		mutex_unlock(&hba->host->scan_mutex);
 		goto out;
 	}
@@ -1477,9 +1477,9 @@
 
 static void ufshcd_clock_scaling_unprepare(struct ufs_hba *hba, int err)
 {
+	blk_mq_unquiesce_tagset(&hba->host->tag_set);
 	up_write(&hba->clk_scaling_lock);
 	mutex_unlock(&hba->wb_mutex);
-	blk_mq_unquiesce_tagset(&hba->host->tag_set);
 	mutex_unlock(&hba->host->scan_mutex);
 
 	/* Enable Write Booster if current gear requires it else disable it */
