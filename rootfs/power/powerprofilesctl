#!/usr/bin/env python3
import sys
import subprocess

def get_prop(prop):
    cmd = ["busctl", "get-property", "org.freedesktop.UPower.PowerProfiles",
           "/org/freedesktop/UPower/PowerProfiles",
           "org.freedesktop.UPower.PowerProfiles", prop]
    out = subprocess.check_output(cmd, text=True).strip()
    if out.startswith('s "') and out.endswith('"'):
        return out[3:-1]
    return out

def set_prop(prop, val):
    cmd = ["busctl", "set-property", "org.freedesktop.UPower.PowerProfiles",
           "/org/freedesktop/UPower/PowerProfiles",
           "org.freedesktop.UPower.PowerProfiles", prop, "s", val]
    subprocess.check_call(cmd)

def main():
    args = sys.argv[1:]
    if not args or args[0] in ("get", "status"):
        print(get_prop("ActiveProfile"))
    elif args[0] == "set":
        if len(args) < 2:
            print("Usage: powerprofilesctl set <profile>", file=sys.stderr)
            sys.exit(1)
        set_prop("ActiveProfile", args[1])
    elif args[0] == "list":
        active = get_prop("ActiveProfile")
        for p in ["power-saver", "balanced", "performance"]:
            marker = "*" if p == active else " "
            print(f"{marker} {p}:")
            print(f"    Driver: armada")
    elif args[0] == "list-holds":
        print("No active holds")
    elif args[0] in ("--help", "-h", "help"):
        print("Usage: powerprofilesctl [get|set <profile>|list|list-holds]")
    else:
        print(f"Unknown command: {args[0]}", file=sys.stderr)
        sys.exit(1)

if __name__ == "__main__":
    main()
